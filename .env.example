# ==============================================================================
# FINOVA ENTERPRISE — Environment Configuration (.env)
# ==============================================================================

# Application Environment & URLs
PORT=3000
NEXT_PUBLIC_APP_URL="https://finovapay.vercel.app"
NEXT_PUBLIC_APP_NAME="FINOVA Enterprise"

# Security & Session Authentication
SESSION_SECRET="finova_enterprise_double_entry_ledger_super_secret_key_2026"
NEXT_PUBLIC_ENABLE_AUDIT_LOGS="true"

# Master Financial Thresholds (in Paise)
# ₹5,00,000.00 Dual Signatory Approval Threshold (50,000,000 paise)
NEXT_PUBLIC_DUAL_APPROVAL_THRESHOLD_PAISE="50000000"

# Telemetry & Compliance Mode
NEXT_PUBLIC_COMPLIANCE_MODE="RBI_MASTER_DIRECTIONS"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
